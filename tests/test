#!/usr/bin/env bash
# Comprehensive test suite for font application
# Tests every function in isolation before integrating with fzf

set -euo pipefail

# Source the libraries
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FONT_APP_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
source "$FONT_APP_DIR/lib/lib.sh"
source "$FONT_APP_DIR/lib/storage.sh"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Test counters
TESTS_RUN=0
TESTS_PASSED=0
TESTS_FAILED=0

# Test result tracking
declare -a FAILED_TESTS=()

# ==============================================================================
# TEST HELPERS
# ==============================================================================

test_start() {
  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "TEST: $1"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  TESTS_RUN=$((TESTS_RUN + 1))
}

test_pass() {
  echo -e "${GREEN}✓ PASS${NC}: $1"
  TESTS_PASSED=$((TESTS_PASSED + 1))
}

test_fail() {
  echo -e "${RED}✗ FAIL${NC}: $1"
  TESTS_FAILED=$((TESTS_FAILED + 1))
  FAILED_TESTS+=("$1")
}

test_info() {
  echo -e "${YELLOW}ℹ INFO${NC}: $1"
}

# ==============================================================================
# TEST SUITE
# ==============================================================================

test_list_fonts() {
  test_start "List fonts function"

  local font_count
  font_count=$(count_fonts)

  test_info "Found $font_count fonts"

  if [[ $font_count -gt 0 ]]; then
    test_pass "list_fonts returns fonts"
  else
    test_fail "list_fonts returned no fonts"
    return 1
  fi

  # Show first few fonts
  test_info "Sample fonts:"
  list_fonts | head -5 | while read -r font; do
    test_info "  - $font"
  done
}

test_get_font_file_path() {
  test_start "Get font file path for each font"

  local fonts_checked=0
  local fonts_found=0
  local fonts_missing=0

  while IFS= read -r font; do
    fonts_checked=$((fonts_checked + 1))

    if font_file=$(get_font_file_path "$font"); then
      fonts_found=$((fonts_found + 1))
      test_pass "Font file found: $font -> $font_file"
    else
      fonts_missing=$((fonts_missing + 1))
      test_fail "Font file NOT found: $font"
    fi
  done < <(list_fonts)

  test_info "Summary: $fonts_checked fonts checked, $fonts_found found, $fonts_missing missing"

  if [[ $fonts_missing -eq 0 ]]; then
    test_pass "All fonts have accessible file paths"
  else
    test_fail "$fonts_missing fonts could not be located"
    return 1
  fi
}

# ==============================================================================
# TERMINAL DETECTION TESTS
# ==============================================================================

test_terminal_detection() {
  test_start "Terminal detection"

  # Source terminal.sh
  source "$FONT_APP_DIR/lib/terminal.sh"

  # Test Ghostty detection
  local result
  result=$(GHOSTTY_RESOURCES_DIR="/fake" KITTY_WINDOW_ID="" WT_SESSION="" detect_terminal)
  if [[ "$result" == "ghostty" ]]; then
    test_pass "Ghostty detected via GHOSTTY_RESOURCES_DIR"
  else
    test_fail "Ghostty detection failed (got: $result)"
  fi

  # Test Kitty detection
  result=$(GHOSTTY_RESOURCES_DIR="" KITTY_WINDOW_ID="123" WT_SESSION="" detect_terminal)
  if [[ "$result" == "kitty" ]]; then
    test_pass "Kitty detected via KITTY_WINDOW_ID"
  else
    test_fail "Kitty detection failed (got: $result)"
  fi

  # Test Windows Terminal detection
  result=$(GHOSTTY_RESOURCES_DIR="" KITTY_WINDOW_ID="" WT_SESSION="abc" detect_terminal)
  if [[ "$result" == "windows_terminal" ]]; then
    test_pass "Windows Terminal detected via WT_SESSION"
  else
    test_fail "Windows Terminal detection failed (got: $result)"
  fi

  # Test unknown terminal
  result=$(GHOSTTY_RESOURCES_DIR="" KITTY_WINDOW_ID="" WT_SESSION="" detect_terminal)
  if [[ "$result" == "unknown" ]]; then
    test_pass "Unknown terminal when no env vars set"
  else
    test_fail "Unknown terminal detection failed (got: $result)"
  fi
}

# ==============================================================================
# REJECTION LOGIC TESTS
# ==============================================================================

test_rejection_logic() {
  test_start "Rejection state logic"

  # Create a temporary test history file
  local test_dir="$FONT_APP_DIR/.test-data-$$"
  local test_history="$test_dir/history.jsonl"
  mkdir -p "$test_dir"

  # Save original and override for this test
  local orig_history="${FONT_HISTORY_FILE:-}"
  local orig_state_dir="${FONT_STATE_DIR:-}"
  FONT_HISTORY_FILE="$test_history"
  FONT_STATE_DIR="$test_dir"

  # Start with empty history
  : > "$test_history"

  local test_font="TestFont-$$"

  # Test 1: Font should not be rejected initially
  if ! is_font_rejected "$test_font"; then
    test_pass "Font not rejected initially"
  else
    test_fail "Font incorrectly marked as rejected initially"
  fi

  # Test 2: Reject the font
  reject_font "$test_font" "Test rejection reason"
  if is_font_rejected "$test_font"; then
    test_pass "Font rejected after reject_font()"
  else
    test_fail "Font not rejected after reject_font()"
  fi

  # Test 3: Check rejection info
  local info
  info=$(get_rejected_font_info "$test_font")
  local reason
  reason=$(echo "$info" | jq -r '.message // .reason // ""')
  if [[ "$reason" == "Test rejection reason" ]]; then
    test_pass "Rejection reason stored correctly"
  else
    test_fail "Rejection reason not stored (got: $reason)"
  fi

  # Test 4: Unreject the font
  unreject_font "$test_font"
  if ! is_font_rejected "$test_font"; then
    test_pass "Font not rejected after unreject_font()"
  else
    test_fail "Font still rejected after unreject_font()"
  fi

  # Test 5: Reject again to verify state toggle works
  reject_font "$test_font" "Second rejection"
  if is_font_rejected "$test_font"; then
    test_pass "Font rejected again after second reject_font()"
  else
    test_fail "Font not rejected after second reject_font()"
  fi

  # Test 6: Rejection persists after sync rewrites history
  reject_font "Nimbus Mono PS" "System font on Windows"

  # Simulate sync rewriting history
  local rewritten
  rewritten=$(jq -s -c 'sort_by(.ts) | .[]' "$test_history")
  echo "$rewritten" > "$test_history"

  if is_font_rejected "Nimbus Mono PS"; then
    test_pass "Nimbus Mono PS still rejected after sync"
  else
    test_fail "Nimbus Mono PS rejection lost after sync (bad normalization?)"
  fi

  # Cleanup
  rm -rf "$test_dir"
  FONT_HISTORY_FILE="$orig_history"
  FONT_STATE_DIR="$orig_state_dir"
}

# ==============================================================================
# MAIN TEST RUNNER
# ==============================================================================

main() {
  # Parse arguments
  FULL_TEST=false
  for arg in "$@"; do
    case "$arg" in
      --full) FULL_TEST=true ;;
    esac
  done
  export FULL_TEST

  echo "╔════════════════════════════════════════════════════════════════════════╗"
  echo "║                    FONT-SYNC TEST SUITE                                ║"
  echo "╚════════════════════════════════════════════════════════════════════════╝"

  test_info "Starting test suite..."
  if [[ "$FULL_TEST" == "true" ]]; then
    test_info "Mode: FULL (testing all fonts)"
  else
    test_info "Mode: Quick (testing sample fonts, use --full for all)"
  fi

  # Run all tests
  test_list_fonts
  test_get_font_file_path
  test_terminal_detection
  test_rejection_logic

  # Summary
  echo ""
  echo "╔════════════════════════════════════════════════════════════════════════╗"
  echo "║                         TEST SUMMARY                                   ║"
  echo "╚════════════════════════════════════════════════════════════════════════╝"
  echo ""
  echo "Total tests run:    $TESTS_RUN"
  echo -e "${GREEN}Tests passed:       $TESTS_PASSED${NC}"

  if [[ $TESTS_FAILED -gt 0 ]]; then
    echo -e "${RED}Tests failed:       $TESTS_FAILED${NC}"
    echo ""
    echo "Failed tests:"
    for test in "${FAILED_TESTS[@]}"; do
      echo -e "  ${RED}✗${NC} $test"
    done
    echo ""
    exit 1
  else
    echo -e "${GREEN}All tests passed!${NC}"
    echo ""
    exit 0
  fi
}

main "$@"
