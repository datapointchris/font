#!/usr/bin/env bash
# Comprehensive test suite for font application
# Tests every function in isolation before integrating with fzf

set -euo pipefail

# Source the libraries
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FONT_APP_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
source "$FONT_APP_DIR/lib/lib.sh"
source "$FONT_APP_DIR/lib/storage.sh"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Test counters
TESTS_RUN=0
TESTS_PASSED=0
TESTS_FAILED=0

# Test result tracking
declare -a FAILED_TESTS=()

# ==============================================================================
# TEST HELPERS
# ==============================================================================

test_start() {
  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "TEST: $1"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  TESTS_RUN=$((TESTS_RUN + 1))
}

test_pass() {
  echo -e "${GREEN}✓ PASS${NC}: $1"
  TESTS_PASSED=$((TESTS_PASSED + 1))
}

test_fail() {
  echo -e "${RED}✗ FAIL${NC}: $1"
  TESTS_FAILED=$((TESTS_FAILED + 1))
  FAILED_TESTS+=("$1")
}

test_info() {
  echo -e "${YELLOW}ℹ INFO${NC}: $1"
}

# ==============================================================================
# TEST SUITE
# ==============================================================================

test_list_fonts() {
  test_start "List fonts function"

  local font_count
  font_count=$(count_fonts)

  test_info "Found $font_count fonts"

  if [[ $font_count -gt 0 ]]; then
    test_pass "list_fonts returns fonts"
  else
    test_fail "list_fonts returned no fonts"
    return 1
  fi

  # Show first few fonts
  test_info "Sample fonts:"
  list_fonts | head -5 | while read -r font; do
    test_info "  - $font"
  done
}

test_get_font_file_path() {
  test_start "Get font file path for each font"

  local fonts_checked=0
  local fonts_found=0
  local fonts_missing=0

  while IFS= read -r font; do
    fonts_checked=$((fonts_checked + 1))

    if font_file=$(get_font_file_path "$font"); then
      fonts_found=$((fonts_found + 1))
      test_pass "Font file found: $font -> $font_file"
    else
      fonts_missing=$((fonts_missing + 1))
      test_fail "Font file NOT found: $font"
    fi
  done < <(list_fonts)

  test_info "Summary: $fonts_checked fonts checked, $fonts_found found, $fonts_missing missing"

  if [[ $fonts_missing -eq 0 ]]; then
    test_pass "All fonts have accessible file paths"
  else
    test_fail "$fonts_missing fonts could not be located"
    return 1
  fi
}

# ==============================================================================
# TERMINAL DETECTION TESTS
# ==============================================================================

test_terminal_detection() {
  test_start "Terminal detection"

  # Source terminal.sh
  source "$FONT_APP_DIR/lib/terminal.sh"

  # Test Ghostty detection
  local result
  result=$(GHOSTTY_RESOURCES_DIR="/fake" KITTY_WINDOW_ID="" WT_SESSION="" detect_terminal)
  if [[ "$result" == "ghostty" ]]; then
    test_pass "Ghostty detected via GHOSTTY_RESOURCES_DIR"
  else
    test_fail "Ghostty detection failed (got: $result)"
  fi

  # Test Kitty detection
  result=$(GHOSTTY_RESOURCES_DIR="" KITTY_WINDOW_ID="123" WT_SESSION="" detect_terminal)
  if [[ "$result" == "kitty" ]]; then
    test_pass "Kitty detected via KITTY_WINDOW_ID"
  else
    test_fail "Kitty detection failed (got: $result)"
  fi

  # Test Windows Terminal detection
  result=$(GHOSTTY_RESOURCES_DIR="" KITTY_WINDOW_ID="" WT_SESSION="abc" detect_terminal)
  if [[ "$result" == "windows_terminal" ]]; then
    test_pass "Windows Terminal detected via WT_SESSION"
  else
    test_fail "Windows Terminal detection failed (got: $result)"
  fi

  # Test unknown terminal
  result=$(GHOSTTY_RESOURCES_DIR="" KITTY_WINDOW_ID="" WT_SESSION="" detect_terminal)
  if [[ "$result" == "unknown" ]]; then
    test_pass "Unknown terminal when no env vars set"
  else
    test_fail "Unknown terminal detection failed (got: $result)"
  fi
}

# ==============================================================================
# REJECTION LOGIC TESTS
# ==============================================================================

test_rejection_logic() {
  test_start "Rejection state logic"

  # Create a temporary test history file
  local test_dir="$FONT_APP_DIR/.test-data-$$"
  local test_history="$test_dir/history.jsonl"
  mkdir -p "$test_dir"

  # Save original and override for this test
  local orig_history="${FONT_HISTORY_FILE:-}"
  local orig_state_dir="${FONT_STATE_DIR:-}"
  FONT_HISTORY_FILE="$test_history"
  FONT_STATE_DIR="$test_dir"

  # Start with empty history
  : > "$test_history"

  local test_font="TestFont-$$"

  # Test 1: Font should not be rejected initially
  if ! is_font_rejected "$test_font"; then
    test_pass "Font not rejected initially"
  else
    test_fail "Font incorrectly marked as rejected initially"
  fi

  # Test 2: Reject the font
  reject_font "$test_font" "Test rejection reason"
  if is_font_rejected "$test_font"; then
    test_pass "Font rejected after reject_font()"
  else
    test_fail "Font not rejected after reject_font()"
  fi

  # Test 3: Check rejection info
  local info
  info=$(get_rejected_font_info "$test_font")
  local reason
  reason=$(echo "$info" | jq -r '.message // .reason // ""')
  if [[ "$reason" == "Test rejection reason" ]]; then
    test_pass "Rejection reason stored correctly"
  else
    test_fail "Rejection reason not stored (got: $reason)"
  fi

  # Test 4: Unreject the font
  unreject_font "$test_font"
  if ! is_font_rejected "$test_font"; then
    test_pass "Font not rejected after unreject_font()"
  else
    test_fail "Font still rejected after unreject_font()"
  fi

  # Test 5: Reject again to verify state toggle works
  reject_font "$test_font" "Second rejection"
  if is_font_rejected "$test_font"; then
    test_pass "Font rejected again after second reject_font()"
  else
    test_fail "Font not rejected after second reject_font()"
  fi

  # Test 6: Rejection persists after sync rewrites history
  reject_font "Nimbus Mono PS" "System font on Windows"

  # Simulate sync rewriting history
  local rewritten
  rewritten=$(jq -s -c 'sort_by(.ts) | .[]' "$test_history")
  echo "$rewritten" > "$test_history"

  if is_font_rejected "Nimbus Mono PS"; then
    test_pass "Nimbus Mono PS still rejected after sync"
  else
    test_fail "Nimbus Mono PS rejection lost after sync (bad normalization?)"
  fi

  # Cleanup
  rm -rf "$test_dir"
  FONT_HISTORY_FILE="$orig_history"
  FONT_STATE_DIR="$orig_state_dir"
}

test_rankings() {
  test_start "Rankings: registry filter, dual sort, exit-1 regression"

  local test_dir="$FONT_APP_DIR/.test-data-rank-$$"
  local test_history="$test_dir/history.jsonl"
  mkdir -p "$test_dir"

  local orig_history="${FONT_HISTORY_FILE:-}"
  local orig_state_dir="${FONT_STATE_DIR:-}"
  FONT_HISTORY_FILE="$test_history"
  FONT_STATE_DIR="$test_dir"
  : > "$test_history"

  # Two real managed fonts plus one unmanaged font that sorts LAST by score.
  # An unmanaged lowest-scored font is exactly what used to make `font rank`
  # exit 1 (the filter loop's final grep failed under `set -e`).
  local managed_a managed_b
  managed_a=$(list_fonts | sed -n '1p')
  managed_b=$(list_fonts | sed -n '2p')

  # managed_a: applied twice + liked (score +1, more usage). managed_b: applied
  # once (score 0). Unmanaged font is disliked -> lowest score, sorts last (the
  # exact condition that used to trip the exit-1 bug).
  {
    echo "{\"ts\":\"2026-01-01T10:00:00Z\",\"font\":\"$managed_a\",\"action\":\"apply\",\"platform\":\"macos\"}"
    echo "{\"ts\":\"2026-01-01T12:00:00Z\",\"font\":\"$managed_a\",\"action\":\"like\",\"platform\":\"macos\"}"
    echo "{\"ts\":\"2026-01-02T10:00:00Z\",\"font\":\"$managed_b\",\"action\":\"apply\",\"platform\":\"macos\"}"
    echo "{\"ts\":\"2026-01-03T10:00:00Z\",\"font\":\"$managed_a\",\"action\":\"apply\",\"platform\":\"macos\"}"
    echo "{\"ts\":\"2026-01-04T10:00:00Z\",\"font\":\"ZZZ Unmanaged Font\",\"action\":\"apply\",\"platform\":\"macos\"}"
    echo "{\"ts\":\"2026-01-04T11:00:00Z\",\"font\":\"ZZZ Unmanaged Font\",\"action\":\"dislike\",\"platform\":\"macos\"}"
  } >> "$test_history"

  # Replicate the show_rankings filter (managed fonts only), under pipefail.
  local available_json filtered filter_status
  available_json=$(list_fonts | jq -R . | jq -s .)
  set -o pipefail
  filtered=$(get_rankings | jq -s --argjson avail "$available_json" \
    'map(select(.font as $f | ($avail | index($f)) != null))')
  filter_status=$?
  set +o pipefail

  if [[ $filter_status -eq 0 ]]; then
    test_pass "Ranking pipeline exits 0 with unmanaged lowest-scored font (exit-1 regression)"
  else
    test_fail "Ranking pipeline exited $filter_status (exit-1 regression)"
  fi

  local kept
  kept=$(echo "$filtered" | jq 'length')
  if [[ "$kept" -eq 2 ]]; then
    test_pass "Registry filter keeps only the 2 managed fonts"
  else
    test_fail "Registry filter kept $kept fonts (expected 2)"
  fi

  if echo "$filtered" | jq -e --arg f "ZZZ Unmanaged Font" 'any(.font == $f)' >/dev/null; then
    test_fail "Unmanaged font leaked into rankings"
  else
    test_pass "Unmanaged font excluded from rankings"
  fi

  # BY LIKES top = managed_a (score +1 vs managed_b 0)
  local likes_top
  likes_top=$(echo "$filtered" | jq -r 'sort_by(.score, .sort_key) | reverse | .[0].font')
  if [[ "$likes_top" == "$managed_a" ]]; then
    test_pass "BY LIKES sorts highest score first"
  else
    test_fail "BY LIKES top was '$likes_top' (expected '$managed_a')"
  fi

  # BY HOURS top = managed_a (applied twice, more elapsed usage than managed_b)
  local hours_top
  hours_top=$(echo "$filtered" | jq -r 'sort_by(.usage_seconds) | reverse | .[0].font')
  if [[ "$hours_top" == "$managed_a" ]]; then
    test_pass "BY HOURS USED sorts most-used first"
  else
    test_fail "BY HOURS USED top was '$hours_top' (expected '$managed_a')"
  fi

  rm -rf "$test_dir"
  FONT_HISTORY_FILE="$orig_history"
  FONT_STATE_DIR="$orig_state_dir"
}

test_font_stats() {
  test_start "Per-font usage stats: session collapse and context mode"

  local test_dir="$FONT_APP_DIR/.test-data-stats-$$"
  local test_history="$test_dir/history.jsonl"
  mkdir -p "$test_dir"

  local orig_history="${FONT_HISTORY_FILE:-}"
  local orig_state_dir="${FONT_STATE_DIR:-}"
  FONT_HISTORY_FILE="$test_history"
  FONT_STATE_DIR="$test_dir"
  : > "$test_history"

  # Font A applied twice back-to-back (one session), then again after B (a
  # second session). Machine m1 dominates (2 of 3 applies), size 14 dominates.
  {
    echo '{"ts":"2026-01-01T10:00:00Z","font":"A","action":"apply","machine":"m1","font_size":14,"terminal":"ghostty"}'
    echo '{"ts":"2026-01-01T11:00:00Z","font":"A","action":"apply","machine":"m1","font_size":14,"terminal":"ghostty"}'
    echo '{"ts":"2026-01-01T12:00:00Z","font":"B","action":"apply","machine":"m2","font_size":16,"terminal":"kitty"}'
    echo '{"ts":"2026-01-01T13:00:00Z","font":"A","action":"apply","machine":"m2","font_size":16,"terminal":"kitty"}'
  } >> "$test_history"

  local stats
  stats=$(get_font_usage_stats "A")

  local sessions
  sessions=$(echo "$stats" | jq -r '.sessions')
  if [[ "$sessions" -eq 2 ]]; then
    test_pass "Consecutive same-font applies collapse to one session (2 runs)"
  else
    test_fail "Session count was $sessions (expected 2)"
  fi

  # Completed durations for A: 10->11 (1h) + 11->12 (1h) = 7200s minimum.
  local usage
  usage=$(echo "$stats" | jq -r '.usage_seconds')
  if [[ "$usage" -ge 7200 ]]; then
    test_pass "Usage seconds accumulate across sessions (>= 7200)"
  else
    test_fail "Usage seconds was $usage (expected >= 7200)"
  fi

  local mode_machine mode_size
  mode_machine=$(get_font_context_mode "A" | jq -r '.machine')
  mode_size=$(get_font_context_mode "A" | jq -r '.size')
  if [[ "$mode_machine" == "m1" ]]; then
    test_pass "Context mode picks most common machine (m1)"
  else
    test_fail "Context mode machine was '$mode_machine' (expected 'm1')"
  fi
  if [[ "$mode_size" == "14" ]]; then
    test_pass "Context mode picks most common font size (14)"
  else
    test_fail "Context mode size was '$mode_size' (expected '14')"
  fi

  # The monthly usage buckets must sum to the same total as usage_seconds —
  # every second of usage is attributed to exactly one month.
  local map_sum
  map_sum=$(get_font_monthly_usage_map "A" | jq '[.[]] | add // 0')
  if [[ "$map_sum" -eq "$usage" ]]; then
    test_pass "Monthly usage buckets sum to total usage ($usage)"
  else
    test_fail "Monthly buckets summed to $map_sum (expected $usage)"
  fi

  rm -rf "$test_dir"
  FONT_HISTORY_FILE="$orig_history"
  FONT_STATE_DIR="$orig_state_dir"
}

test_dashboard() {
  test_start "Portfolio stats: overview counts and discovery buckets"

  local test_dir="$FONT_APP_DIR/.test-data-dash-$$"
  local test_history="$test_dir/history.jsonl"
  mkdir -p "$test_dir"

  local orig_history="${FONT_HISTORY_FILE:-}"
  local orig_state_dir="${FONT_STATE_DIR:-}"
  FONT_HISTORY_FILE="$test_history"
  FONT_STATE_DIR="$test_dir"
  : > "$test_history"

  # Empty history: overview reports zero fonts, no crash.
  local empty_tried
  empty_tried=$(get_stats_overview | jq -r '.fonts_tried')
  if [[ "$empty_tried" -eq 0 ]]; then
    test_pass "Overview reports 0 fonts on empty history"
  else
    test_fail "Overview reported $empty_tried fonts on empty history"
  fi

  # A first tried in Jan (re-applied in Feb should not re-count), B in Jan, C in Mar.
  {
    echo '{"ts":"2026-01-05T10:00:00Z","font":"A","action":"apply","machine":"m1"}'
    echo '{"ts":"2026-01-20T10:00:00Z","font":"B","action":"apply","machine":"m1"}'
    echo '{"ts":"2026-02-10T10:00:00Z","font":"A","action":"apply","machine":"m1"}'
    echo '{"ts":"2026-02-11T10:00:00Z","font":"A","action":"like","machine":"m1"}'
    echo '{"ts":"2026-03-01T10:00:00Z","font":"C","action":"apply","machine":"m1"}'
  } >> "$test_history"

  local tried applies
  tried=$(get_stats_overview | jq -r '.fonts_tried')
  applies=$(get_stats_overview | jq -r '.total_applies')
  if [[ "$tried" -eq 3 && "$applies" -eq 4 ]]; then
    test_pass "Overview counts 3 fonts tried, 4 applies"
  else
    test_fail "Overview counted tried=$tried applies=$applies (expected 3/4)"
  fi

  # Discovery buckets by first-apply month: Jan has A and B, Mar has C. Feb's
  # re-apply of A must not appear.
  local discovery
  discovery=$(get_stats_discovery)
  local jan_count feb_present
  jan_count=$(echo "$discovery" | jq -r '.[] | select(.month == "2026-01") | .count')
  feb_present=$(echo "$discovery" | jq '[.[] | select(.month == "2026-02")] | length')
  if [[ "$jan_count" -eq 2 && "$feb_present" -eq 0 ]]; then
    test_pass "Discovery buckets by first-tried month (Jan=2, no Feb)"
  else
    test_fail "Discovery Jan=$jan_count Feb-entries=$feb_present (expected 2 / 0)"
  fi

  rm -rf "$test_dir"
  FONT_HISTORY_FILE="$orig_history"
  FONT_STATE_DIR="$orig_state_dir"
}

# ==============================================================================
# MAIN TEST RUNNER
# ==============================================================================

main() {
  # Parse arguments
  FULL_TEST=false
  for arg in "$@"; do
    case "$arg" in
      --full) FULL_TEST=true ;;
    esac
  done
  export FULL_TEST

  echo "╔════════════════════════════════════════════════════════════════════════╗"
  echo "║                    FONT-SYNC TEST SUITE                                ║"
  echo "╚════════════════════════════════════════════════════════════════════════╝"

  test_info "Starting test suite..."
  if [[ "$FULL_TEST" == "true" ]]; then
    test_info "Mode: FULL (testing all fonts)"
  else
    test_info "Mode: Quick (testing sample fonts, use --full for all)"
  fi

  # Run all tests
  test_list_fonts
  test_get_font_file_path
  test_terminal_detection
  test_rejection_logic
  test_rankings
  test_font_stats
  test_dashboard

  # Summary
  echo ""
  echo "╔════════════════════════════════════════════════════════════════════════╗"
  echo "║                         TEST SUMMARY                                   ║"
  echo "╚════════════════════════════════════════════════════════════════════════╝"
  echo ""
  echo "Total tests run:    $TESTS_RUN"
  echo -e "${GREEN}Tests passed:       $TESTS_PASSED${NC}"

  if [[ $TESTS_FAILED -gt 0 ]]; then
    echo -e "${RED}Tests failed:       $TESTS_FAILED${NC}"
    echo ""
    echo "Failed tests:"
    for test in "${FAILED_TESTS[@]}"; do
      echo -e "  ${RED}✗${NC} $test"
    done
    echo ""
    exit 1
  else
    echo -e "${GREEN}All tests passed!${NC}"
    echo ""
    exit 0
  fi
}

main "$@"
