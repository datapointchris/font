#!/usr/bin/env bash
# Font management - built on tested library
# fzf integration layer on top of font library

set -euo pipefail

# Source the library (handle symlinks)
SCRIPT_PATH="${BASH_SOURCE[0]:-$0}"
if [[ -L "$SCRIPT_PATH" ]]; then
  # Get absolute path of symlink target
  SCRIPT_PATH="$(python3 -c "import os; print(os.path.realpath('$SCRIPT_PATH'))")"
fi
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
FONT_APP_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# Source formatting library for colorized help
if [[ -f "$HOME/.local/shell/formatting.sh" ]]; then
  source "$HOME/.local/shell/formatting.sh"
elif [[ -f "$HOME/dotfiles/platforms/common/.local/shell/formatting.sh" ]]; then
  source "$HOME/dotfiles/platforms/common/.local/shell/formatting.sh"
fi

source "$FONT_APP_DIR/lib/lib.sh"
source "$FONT_APP_DIR/lib/storage.sh"
source "$FONT_APP_DIR/lib/terminal.sh"
source "$FONT_APP_DIR/lib/sync.sh"

# Sourced if present rather than required, so an installation predating this
# dependency still runs every command it ran before. `font update` says how to
# get it; the notice simply does not appear. Re-running install.sh installs it.
BASHSELFUPDATE_LOAD="${XDG_LIB_HOME:-$HOME/.local/lib}/bashselfupdate/load.bash"
if [[ -f "$BASHSELFUPDATE_LOAD" ]]; then
  # shellcheck source=/dev/null
  source "$BASHSELFUPDATE_LOAD"
fi

# Get version from git tags (no VERSION file needed)
get_version() {
  git -C "$FONT_APP_DIR" describe --tags --always 2>/dev/null || echo "dev"
}

# List managed fonts excluding rejected ones (for font random)
list_fonts_not_rejected() {
  list_fonts | while IFS= read -r font; do
    if ! is_font_rejected "$font"; then
      echo "$font"
    fi
  done
}

usage() {
  # Check if formatting functions are available
  if command -v print_header &>/dev/null; then
    print_section "Font Testing & Management" "yellow"

    print_section "Commands" "blue"
    cat <<'EOF'
  current              Show active font with full stats
  info                 Browse fonts and view detailed history
  change               Interactive font picker (shows per-font stats)
  apply <font>         Apply font to all terminals (auto-logs)
  size-up              Increase font size by 1
  size-down            Decrease font size by 1
  like [message]       Like current font with optional reason
  dislike [message]    Dislike current font with optional reason
  note <message>       Add note to current font (message required)
  random               Apply a least-used font (spreads coverage)
  last                 Toggle to previously used font
  rank                 Show fonts ranked by likes and by hours used
  stats                Portfolio dashboard (divergence, discovery, per-machine)
  log                  View complete history
  list                 List all curated font families
  reject <message>     Mark current font as rejected (avoids rediscovery)
  rejected             List all rejected fonts
  unreject             Restore a rejected font (fzf picker with history)
  sync init            Set up cross-machine sync via GitHub Gist
  sync status          Show sync status
  sync push            Force push to gist
  sync pull            Force pull from gist
  sync off             Disable auto-sync
  sync on              Re-enable auto-sync
  install              Install curated fonts from GitHub Release
  install --check      Show which curated fonts are missing
  upgrade              Update font to latest release
EOF

    print_section "Examples" "yellow"
    if command -v print_cyan &>/dev/null; then
      echo "  $(print_cyan "font change")                         # Interactive picker"
      echo "  $(print_cyan "font size-up")                        # Increase font size"
      echo "  $(print_cyan "font size-down")                      # Decrease font size"
      echo "  $(print_cyan "font like \"Great ligatures\"")         # Like with reason"
      echo "  $(print_cyan "font dislike \"Too wide\"")             # Dislike with reason"
      echo "  $(print_cyan "font note \"Good for prose\"")          # Add note"
      echo "  $(print_cyan "font rank")                            # See rankings"
      echo "  $(print_cyan "font log")                             # View history"
    else
      cat <<'EOF'
  font change                         # Interactive picker
  font size-up                        # Increase font size
  font size-down                      # Decrease font size
  font like "Great ligatures"         # Like with reason
  font dislike "Too wide"             # Dislike with reason
  font note "Good for prose"          # Add note
  font rank                           # See rankings
  font log                            # View history
EOF
    fi

    print_section "Data Storage" "green"
    cat <<'EOF'
  History: ~/.local/state/font/history.jsonl

  Single history file with terminal context, synced across machines.
  View details: font log
EOF

  else
    # Fallback for when formatting library is not available
    cat <<'EOF'
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
 Font Management
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

Commands
─────────────────────────
  current              Show active font with full stats
  info                 Browse fonts and view detailed history
  change               Interactive font picker (shows per-font stats)
  apply <font>         Apply font to all terminals (auto-logs)
  size-up              Increase font size by 1
  size-down            Decrease font size by 1
  like [message]       Like current font with optional reason
  dislike [message]    Dislike current font with optional reason
  note <message>       Add note to current font (message required)
  random               Apply a least-used font (spreads coverage)
  last                 Toggle to previously used font
  rank                 Show fonts ranked by likes and by hours used
  stats                Portfolio dashboard (divergence, discovery, per-machine)
  log                  View complete history
  list                 List all curated font families
  reject <message>     Mark current font as rejected (avoids rediscovery)
  rejected             List all rejected fonts
  unreject             Restore a rejected font (fzf picker with history)
  sync init            Set up cross-machine sync via GitHub Gist
  sync status          Show sync status
  sync push            Force push to gist
  sync pull            Force pull from gist
  sync off             Disable auto-sync
  sync on              Re-enable auto-sync
  install              Install curated fonts from GitHub Release
  install --check      Show which curated fonts are missing
  upgrade              Update font to latest release

Examples
─────────────────────────
  font change                         # Interactive picker
  font size-up                        # Increase font size
  font size-down                      # Decrease font size
  font like "Great ligatures"         # Like with reason
  font dislike "Too wide"             # Dislike with reason
  font note "Good for prose"          # Add note
  font rank                           # See rankings
  font log                            # View history

Data Storage
─────────────────────────
  History: ~/.local/state/font/history.jsonl

  Single history file with terminal context, synced across machines.
  View details: font log

EOF
  fi
}

#==============================================================================
# FONT OPERATIONS
# ==============================================================================

apply_font_cmd() {
  local font="$1"

  echo "Applying font: $font"

  local applied
  if applied=$(terminal_apply_font "$font"); then
    log_action "apply" "$font"
    sync_after_action
    echo ""
    echo "Applied to: $applied"
    echo ""
    echo "Font applied! Restart terminal to see all changes."
  else
    echo "Error: Failed to apply font" >&2
    return 1
  fi
}

cmd_size_up() {
  local result
  if result=$(change_font_size 1); then
    echo "Font size: $result"
    echo ""
    echo "Restart terminal to see changes."
  else
    return 1
  fi
}

cmd_size_down() {
  local result
  if result=$(change_font_size -1); then
    echo "Font size: $result"
    echo ""
    echo "Restart terminal to see changes."
  else
    return 1
  fi
}

mark_liked() {
  local message="$*"
  local font
  font=$(get_current_font)

  if [[ "$font" == "Unknown" ]]; then
    echo "Error: No font currently configured"
    exit 1
  fi

  log_action "like" "$font" "$message"
  sync_after_action
  echo "✓ Liked: $font"
  [[ -n "$message" ]] && echo "  Reason: $message"
}

mark_disliked() {
  local message="$*"
  local font
  font=$(get_current_font)

  if [[ "$font" == "Unknown" ]]; then
    echo "Error: No font currently configured"
    exit 1
  fi

  log_action "dislike" "$font" "$message"
  sync_after_action
  echo "✓ Disliked: $font"
  [[ -n "$message" ]] && echo "  Reason: $message"
}

add_note() {
  local message="$*"
  local font
  font=$(get_current_font)

  if [[ "$font" == "Unknown" ]]; then
    echo "Error: No font currently configured"
    exit 1
  fi

  if [[ -z "$message" ]]; then
    echo "Error: Note message required"
    echo "Usage: font note <message>"
    exit 1
  fi

  log_action "note" "$font" "$message"
  sync_after_action
  echo "✓ Added note to: $font"
  echo "  Note: $message"
}

mark_rejected() {
  local reason="$*"
  local font
  font=$(get_current_font)

  if [[ "$font" == "Unknown" ]]; then
    echo "Error: No font currently configured"
    exit 1
  fi

  if [[ -z "$reason" ]]; then
    echo "Error: Rejection reason required"
    echo "Usage: font reject <message>"
    exit 1
  fi

  reject_font "$font" "$reason"
  sync_after_action
  echo "✓ Marked as rejected: $font"
  echo "  Reason: $reason"
  echo ""
  echo "This font will be tracked to avoid rediscovery."
}

show_rejected() {
  local rejected
  rejected=$(list_rejected_fonts)

  if [[ -z "$rejected" ]] || [[ "$rejected" == "[]" ]]; then
    echo "No rejected fonts yet."
    echo ""
    echo "When you try a font and don't like it, mark it as rejected:"
    echo "  font reject \"Font Name\" \"reason\""
    return
  fi

  echo ""
  echo "Rejected Fonts"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""

  local count=0
  while IFS= read -r line; do
    count=$((count + 1))
    local font=$(echo "$line" | jq -r '.font')
    local rejected_date=$(echo "$line" | jq -r '.rejected_date')
    local reason=$(echo "$line" | jq -r '.reason')
    local platforms=$(echo "$line" | jq -r '.platforms')

    # Format date
    local date_formatted
    if date --version &>/dev/null 2>&1; then
      # GNU date
      date_formatted=$(date -d "$rejected_date" +"%Y-%m-%d" 2>/dev/null || echo "$rejected_date")
    else
      # BSD date (macOS)
      date_formatted=$(date -j -f "%Y-%m-%dT%H:%M:%S" "${rejected_date:0:19}" +"%Y-%m-%d" 2>/dev/null || echo "$rejected_date")
    fi

    echo "$count. $font"
    echo "   Rejected: $date_formatted"
    echo "   Reason: $reason"
    [[ -n "$platforms" ]] && echo "   Platforms: $platforms"
    echo ""
  done < <(echo "$rejected")

  echo "Total rejected: $count"
  echo ""
}

unreject_font_interactive() {
  if ! command -v fzf &>/dev/null; then
    echo "Error: fzf not found. Install with: brew install fzf"
    exit 1
  fi

  local rejected
  rejected=$(list_rejected_fonts)

  if [[ -z "$rejected" ]] || [[ "$rejected" == "[]" ]]; then
    echo "No rejected fonts to unreject."
    return
  fi

  # Build list of rejected font names
  local font_names
  font_names=$(echo "$rejected" | jq -r '.font')

  if [[ -z "$font_names" ]]; then
    echo "No rejected fonts to unreject."
    return
  fi

  # Create preview script that shows font history
  local preview_script="/tmp/font-unreject-preview-$$.sh"
  cat >"$preview_script" <<'PREVIEW_EOF'
#!/bin/bash
font="$1"
FONT_APP_DIR="$2"

source "$FONT_APP_DIR/lib/storage.sh"

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "Font: $font"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

# Show rejection info
echo "REJECTION INFO:"
echo "───────────────────────────────────────────────────"
rejection_info=$(get_rejected_font_info "$font")
if [[ -n "$rejection_info" ]] && [[ "$rejection_info" != "{}" ]]; then
  rejected_date=$(echo "$rejection_info" | jq -r '.rejected_date // "unknown"')
  reason=$(echo "$rejection_info" | jq -r '.reason // "No reason"')
  platforms=$(echo "$rejection_info" | jq -r '.platforms | join(", ") // "unknown"')
  echo "  Date: $rejected_date"
  echo "  Reason: $reason"
  echo "  Platforms: $platforms"
else
  echo "  No rejection info found"
fi
echo ""

# Show full history
echo "FULL HISTORY:"
echo "───────────────────────────────────────────────────"
history=$(get_history | jq -c --arg font "$font" '.[] | select(.font == $font)')
if [[ -n "$history" ]]; then
  echo "$history" | while IFS= read -r line; do
    ts=$(echo "$line" | jq -r '.ts')
    action=$(echo "$line" | jq -r '.action')
    platform=$(echo "$line" | jq -r '.platform')
    message=$(echo "$line" | jq -r '.message // empty')

    # Format timestamp
    date_part="${ts:0:10}"

    if [[ -n "$message" ]]; then
      printf "  %s | %-8s | %s | %s\n" "$date_part" "$action" "$platform" "$message"
    else
      printf "  %s | %-8s | %s\n" "$date_part" "$action" "$platform"
    fi
  done
else
  echo "  No history found"
fi
echo ""

# Show stats summary
echo "STATS SUMMARY:"
echo "───────────────────────────────────────────────────"
stats=$(get_font_stats "$font" 2>/dev/null)
if [[ -n "$stats" ]] && [[ "$stats" != "null" ]]; then
  likes=$(echo "$stats" | jq -r '.likes // 0')
  dislikes=$(echo "$stats" | jq -r '.dislikes // 0')
  applies=$(echo "$stats" | jq -r '.applies // 0')
  score=$(echo "$stats" | jq -r '.score // 0')
  printf "  Score: %+d (%d likes, %d dislikes)\n" "$score" "$likes" "$dislikes"
  echo "  Times applied: $applies"
else
  echo "  No stats available"
fi
PREVIEW_EOF

  chmod +x "$preview_script"

  # Run fzf with preview
  local selected
  selected=$(echo "$font_names" | fzf \
    --prompt="Select font to unreject > " \
    --height=80% \
    --preview="$preview_script {} '$FONT_APP_DIR'" \
    --preview-window=right:60%)

  # Cleanup
  rm -f "$preview_script"

  if [[ -n "$selected" ]]; then
    unreject_font "$selected"
    sync_after_action
    echo "Unrejected: $selected"
    echo ""
    echo "This font is now available in the font list again."
  fi
}

# Draw a proportional bar of a given width. Args: value, max, width, color.
# Prints filled (colored) + empty segments. A positive value always shows at
# least one filled cell so nonzero values never render as an empty bar.
_rank_bar() {
  local value="$1" max="$2" width="$3" color="$4"
  local c_reset='\033[0m'

  local filled=0
  if [[ "$value" -gt 0 ]] && [[ "$max" -gt 0 ]]; then
    filled=$((value * width / max))
    [[ $filled -lt 1 ]] && filled=1
  fi
  [[ $filled -gt $width ]] && filled=$width
  local empty=$((width - filled))

  local filled_part="" empty_part=""
  [[ $filled -gt 0 ]] && filled_part=$(printf '█%.0s' $(seq 1 "$filled"))
  [[ $empty -gt 0 ]] && empty_part=$(printf '░%.0s' $(seq 1 "$empty"))
  printf '%b%s%b%s' "$color" "$filled_part" "$c_reset" "$empty_part"
}

# Render one ranking section (a labeled, sorted bar chart).
# Args: $1 title, $2 rankings JSON array, $3 mode (likes|hours), $4 name width.
_render_rank_section() {
  local title="$1" rankings="$2" mode="$3" name_width="$4"

  local c_reset='\033[0m'
  local c_green='\033[0;32m'
  local c_red='\033[0;31m'
  local c_white='\033[0;37m'
  local c_blue='\033[0;34m'
  local bar_width=10

  # Sort and pick the metric each section ranks on. BY LIKES ranks on score
  # (recency breaks ties); BY HOURS USED ranks on raw usage seconds.
  local sorted max
  if [[ "$mode" == "likes" ]]; then
    sorted=$(echo "$rankings" | jq -c 'sort_by(.score, .sort_key) | reverse | .[]')
    max=$(echo "$rankings" | jq '[.[].score] | max // 0')
  else
    sorted=$(echo "$rankings" | jq -c 'sort_by(.usage_seconds) | reverse | .[]')
    max=$(echo "$rankings" | jq '[.[].usage_seconds] | max // 0')
  fi

  echo ""
  echo -e "${c_blue}${title}${c_reset}"

  local rank=0
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    rank=$((rank + 1))
    local font score usage_seconds
    font=$(echo "$line" | jq -r '.font')
    score=$(echo "$line" | jq -r '.score')
    usage_seconds=$(echo "$line" | jq -r '.usage_seconds // 0')

    if [[ ${#font} -gt $name_width ]]; then
      font="${font:0:$((name_width - 3))}..."
    fi

    local metric bar
    if [[ "$mode" == "likes" ]]; then
      local score_color="$c_white"
      [[ $score -gt 0 ]] && score_color="$c_green"
      [[ $score -lt 0 ]] && score_color="$c_red"
      metric=$(printf "${score_color}%+3d${c_reset}" "$score")
      bar=$(_rank_bar "$score" "$max" "$bar_width" "$c_green")
    else
      local usage_time="-"
      [[ "$usage_seconds" -gt 0 ]] && usage_time=$(format_duration "$usage_seconds")
      metric=$(printf "%8s" "$usage_time")
      bar=$(_rank_bar "$usage_seconds" "$max" "$bar_width" "$c_green")
    fi

    printf "%2d. %-${name_width}s  %b  %b\n" "$rank" "$font" "$metric" "$bar"
  done <<<"$sorted"
}

show_rankings() {
  # Restrict to fonts in the current registry, then rank the same set two ways.
  local available_json rankings count
  available_json=$(list_fonts | jq -R . | jq -s .)
  rankings=$(get_rankings | jq -s --argjson avail "$available_json" \
    'map(select(.font as $f | ($avail | index($f)) != null))')

  count=$(echo "$rankings" | jq 'length')
  if [[ "$count" -eq 0 ]]; then
    echo "No font data yet. Start using fonts and marking likes/dislikes!"
    return
  fi

  local c_reset='\033[0m'
  local c_gold='\033[0;33m'

  # Shared name width (capped at 35) so both sections align.
  local name_width
  name_width=$(echo "$rankings" | jq '[.[].font | length] | max')
  [[ $name_width -gt 35 ]] && name_width=35

  echo ""
  echo -e "${c_gold}Font Rankings${c_reset}"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

  _render_rank_section "BY LIKES" "$rankings" likes "$name_width"
  _render_rank_section "BY HOURS USED" "$rankings" hours "$name_width"
  echo ""
}

show_stats() {
  local overview
  overview=$(get_stats_overview)

  if [[ -z "$overview" ]] || [[ "$(echo "$overview" | jq -r '.fonts_tried')" -eq 0 ]]; then
    echo "No font data yet. Start using fonts!"
    return
  fi

  local c_reset='\033[0m'
  local c_gold='\033[0;33m'
  local c_blue='\033[0;34m'
  local c_green='\033[0;32m'

  local fonts_tried span_days total_usage liked rejected applies
  fonts_tried=$(echo "$overview" | jq -r '.fonts_tried')
  span_days=$(echo "$overview" | jq -r '.span_days')
  total_usage=$(echo "$overview" | jq -r '.total_usage_seconds')
  liked=$(echo "$overview" | jq -r '.liked_fonts')
  rejected=$(echo "$overview" | jq -r '.rejected_fonts')
  applies=$(echo "$overview" | jq -r '.total_applies')

  echo ""
  echo -e "${c_gold}Font Stats${c_reset}"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""
  printf "Tested %d fonts over %d days · %s total\n" \
    "$fonts_tried" "$span_days" "$(format_duration "$total_usage")"
  printf "Liked %d · Rejected %d · %d applies\n" "$liked" "$rejected" "$applies"

  # Stated-vs-revealed divergence
  local divergence unl lnu
  divergence=$(get_stats_divergence)
  unl=$(echo "$divergence" | jq '.used_not_liked | length')
  lnu=$(echo "$divergence" | jq '.liked_not_used | length')
  if [[ "$unl" -gt 0 || "$lnu" -gt 0 ]]; then
    echo ""
    echo -e "${c_blue}Revealed ≠ stated${c_reset}"
    if [[ "$unl" -gt 0 ]]; then
      echo "  Used a lot but never rated:"
      while IFS=$'\t' read -r font usage; do
        printf "    %-30s %s\n" "$font" "$(format_duration "$usage")"
      done < <(echo "$divergence" | jq -r '.used_not_liked[] | "\(.font)\t\(.usage)"')
    fi
    if [[ "$lnu" -gt 0 ]]; then
      echo "  Liked but rarely used:"
      while IFS=$'\t' read -r font score usage; do
        printf "    %-30s %+d  %s\n" "$font" "$score" "$(format_duration "$usage")"
      done < <(echo "$divergence" | jq -r '.liked_not_used[] | "\(.font)\t\(.score)\t\(.usage)"')
    fi
  fi

  # Discovery timeline (fonts first tried per month)
  local discovery
  discovery=$(get_stats_discovery)
  if [[ "$(echo "$discovery" | jq 'length')" -gt 0 ]]; then
    echo ""
    echo -e "${c_blue}Discovery (new fonts tried per month)${c_reset}"
    local max_count
    max_count=$(echo "$discovery" | jq '[.[].count] | max')
    while IFS=$'\t' read -r month count; do
      printf "  %s  %b  %d\n" "$month" "$(_rank_bar "$count" "$max_count" 10 "$c_green")" "$count"
    done < <(echo "$discovery" | jq -r '.[] | "\(.month)\t\(.count)"')
  fi

  # Favorite font on each machine
  local favorites
  favorites=$(get_stats_machine_favorites)
  if [[ "$(echo "$favorites" | jq 'length')" -gt 0 ]]; then
    echo ""
    echo -e "${c_blue}Favorite by machine${c_reset}"
    local mw
    mw=$(echo "$favorites" | jq -r '[.[].machine | length] | max')
    while IFS=$'\t' read -r machine font usage; do
      printf "  %-${mw}s  %-28s %s\n" "$machine" "$font" "$(format_duration "$usage")"
    done < <(echo "$favorites" | jq -r '.[] | "\(.machine)\t\(.font)\t\(.usage)"')
  fi
  echo ""
}

show_current_font() {
  local font
  font=$(get_current_font)

  if [[ "$font" == "Unknown" ]]; then
    echo "No font currently configured"
    return
  fi

  display_font_details "$font" "full"
}

show_font_info() {
  if ! command -v fzf &>/dev/null; then
    echo "Error: fzf not found. Install with: brew install fzf"
    exit 1
  fi

  sync_before_read

  local preview_script="/tmp/font-info-preview-$$.sh"
  cat >"$preview_script" <<PREVIEW_EOF
#!/bin/bash
source "$FONT_APP_DIR/lib/lib.sh"
source "$FONT_APP_DIR/lib/storage.sh"
font="\$1"
display_font_details "\$font" "full"
PREVIEW_EOF

  chmod +x "$preview_script"

  local selected
  selected=$(list_fonts | fzf \
    --prompt="Select font to view > " \
    --height=100% \
    --preview="$preview_script {}" \
    --preview-window=right:70%)

  rm -f "$preview_script"

  if [[ -n "$selected" ]]; then
    display_font_details "$selected" "full"
  fi
}

show_log() {
  local history
  history=$(get_history_raw)

  if [[ -z "$history" ]]; then
    echo "No history yet. Start using fonts!"
    return
  fi

  echo ""
  echo "Font History Log"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""

  # Show data file info
  echo "Data file: $FONT_HISTORY_FILE"
  if [[ -f "$FONT_HISTORY_FILE" ]]; then
    local entry_count=$(wc -l <"$FONT_HISTORY_FILE" | xargs)
    local rejected_count=$(jq -s 'map(select(.action == "reject")) | length' "$FONT_HISTORY_FILE")
    printf "  Entries: %d\n" "$entry_count"
    printf "  Rejected fonts: %d\n" "$rejected_count"
  fi
  echo ""

  # Format and display with color if bat is available
  if command -v bat &>/dev/null; then
    echo "$history" | jq -r '
      "\(.ts) | \(.machine // .platform) | \(.terminal // "-") | \(.action) | \(.font)" +
      (if .message then " | \(.message)" else "" end)
    ' | bat --plain --language=log --theme=base16
  else
    echo "$history" | jq -r '
      "\(.ts) | \(.machine // .platform) | \(.terminal // "-") | \(.action) | \(.font)" +
      (if .message then " | \(.message)" else "" end)
    '
  fi
}

#==============================================================================
# FZF PREVIEW INTEGRATION
# ==============================================================================

change_font() {
  if ! command -v fzf &>/dev/null; then
    echo "Error: fzf not found. Install with: brew install fzf"
    exit 1
  fi

  # Pull latest history before showing picker
  sync_before_read

  # Preview script shows each font's stats and info in the fzf window
  local preview_script="/tmp/font-change-preview-$$.sh"
  cat >"$preview_script" <<PREVIEW_EOF
#!/bin/bash
source "$FONT_APP_DIR/lib/lib.sh"
source "$FONT_APP_DIR/lib/storage.sh"
display_font_details "\$1" "compact"
PREVIEW_EOF

  chmod +x "$preview_script"

  local selected
  selected=$(list_fonts | fzf \
    --prompt="Select font > " \
    --height=100% \
    --preview="$preview_script {}" \
    --preview-window=right:55%)

  rm -f "$preview_script"

  if [[ -n "$selected" ]]; then
    apply_font_cmd "$selected"
  fi
}

cmd_font_last() {
  # Get the two most recently applied unique fonts
  local recent
  recent=$(get_recently_used 2)

  # Check if we have at least 2 fonts in history
  local count
  count=$(echo "$recent" | jq 'length')

  if [[ "$count" -lt 2 ]]; then
    echo "Error: Need at least 2 fonts in history to toggle"
    echo "Apply another font first, then use 'font last' to toggle between them."
    return 1
  fi

  # Get current font from terminal config
  local current
  current=$(get_current_font)

  # Get the two most recent fonts
  local font_0 font_1
  font_0=$(echo "$recent" | jq -r '.[0].font')
  font_1=$(echo "$recent" | jq -r '.[1].font')

  # Toggle: if current matches most recent, switch to previous; otherwise switch to most recent
  local target
  if [[ "$current" == "$font_0" ]]; then
    target="$font_1"
  else
    target="$font_0"
  fi

  echo "Toggling to previous font..."
  apply_font_cmd "$target"
}

random_font() {
  mapfile -t all_fonts < <(list_fonts_not_rejected)

  if [[ ${#all_fonts[@]} -eq 0 ]]; then
    echo "Error: No fonts found"
    exit 1
  fi

  # Get apply counts for all fonts
  declare -A apply_counts
  while IFS=$'\t' read -r font count; do
    apply_counts["$font"]=$count
  done < <(get_all_apply_counts)

  # Find minimum apply count among available fonts
  local min_count=999999
  for font in "${all_fonts[@]}"; do
    local count="${apply_counts[$font]:-0}"
    if [[ $count -lt $min_count ]]; then
      min_count=$count
    fi
  done

  # Get all fonts with minimum apply count
  local least_used=()
  for font in "${all_fonts[@]}"; do
    local count="${apply_counts[$font]:-0}"
    if [[ $count -eq $min_count ]]; then
      least_used+=("$font")
    fi
  done

  # Pick randomly from least-used fonts
  local selected_font="${least_used[$RANDOM % ${#least_used[@]}]}"

  echo "🎲 Randomly selected: $selected_font"
  echo "   (${#least_used[@]} fonts with $min_count applies)"
  echo ""
  apply_font_cmd "$selected_font"
}

# ==============================================================================
# FONT INSTALLATION
# ==============================================================================

FONT_RELEASE_TAG="fonts-v1"
FONT_RELEASE_REPO="datapointchris/font"

_get_windows_username() {
  cmd.exe /C 'echo %USERNAME%' 2>/dev/null | tr -d '\r\n' | xargs
}

_get_system_font_dir() {
  local platform
  platform=$(detect_platform)
  case "$platform" in
    macos) echo "$HOME/Library/Fonts" ;;
    wsl)
      local win_user
      win_user=$(_get_windows_username)
      if [[ -n "$win_user" ]]; then
        echo "/mnt/c/Users/$win_user/AppData/Local/Microsoft/Windows/Fonts"
      else
        echo "$HOME/.local/share/fonts"
      fi
      ;;
    *) echo "$HOME/.local/share/fonts" ;;
  esac
}

_register_windows_font() {
  local font_path="$1"
  local font_filename="$2"

  local win_path
  win_path=$(wslpath -w "$font_path" 2>/dev/null) || return 1

  powershell.exe -NoProfile -Command "
    \$ErrorActionPreference = 'SilentlyContinue'
    \$fontPath = '$win_path'
    \$fontFileName = '$font_filename'
    try {
      Add-Type -AssemblyName System.Drawing
      \$fc = New-Object System.Drawing.Text.PrivateFontCollection
      \$fc.AddFontFile(\$fontPath)
      \$fontFamily = \$fc.Families[0].Name
      \$style = ''
      if (\$fontFileName -match 'Bold' -and \$fontFileName -match 'Italic') { \$style = ' Bold Italic' }
      elseif (\$fontFileName -match 'Bold') { \$style = ' Bold' }
      elseif (\$fontFileName -match 'Italic') { \$style = ' Italic' }
      \$fontName = \"\$fontFamily\$style (TrueType)\"
    } catch {
      \$fontName = [System.IO.Path]::GetFileNameWithoutExtension(\$fontFileName) + ' (TrueType)'
    }
    \$regPath = 'HKCU:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Fonts'
    Set-ItemProperty -Path \$regPath -Name \$fontName -Value \$fontPath
  " </dev/null 2>/dev/null || true
}

install_fonts() {
  local check_only=false
  if [[ "${1:-}" == "--check" ]]; then
    check_only=true
  fi

  local font_dir
  font_dir=$(_get_system_font_dir)

  # Read curated font list from registry
  local -a curated_fonts
  mapfile -t curated_fonts < <(list_fonts)

  if $check_only; then
    echo "Font directory: $font_dir"
    echo "Curated fonts (${#curated_fonts[@]} families):"
    echo ""
    local missing=0
    for font in "${curated_fonts[@]}"; do
      # Check via fc-list (Linux) or file existence (macOS)
      local found=false
      if command -v fc-list &>/dev/null; then
        fc-list : family | grep -Fq "$font" && found=true
      else
        # macOS: check for font files matching the family name (strip spaces)
        local pattern="${font// /}"
        ls "$font_dir"/"${pattern}"-*.ttf "$font_dir"/"${pattern}"-*.otf &>/dev/null && found=true
      fi
      if $found; then
        echo "  ✓ $font"
      else
        echo "  ✗ $font (not installed)"
        missing=$((missing + 1))
      fi
    done
    echo ""
    if [[ $missing -eq 0 ]]; then
      echo "All fonts installed."
    else
      echo "$missing font(s) missing. Run 'font install' to install."
    fi
    return 0
  fi

  local tmpdir
  tmpdir=$(mktemp -d /tmp/font-install-XXXX)
  trap 'rm -rf "'"$tmpdir"'"' EXIT

  # Check for local archive first (for environments that can't download from GitHub)
  local local_archive="$HOME/fonts.tar.xz"
  if [[ -f "$local_archive" ]]; then
    echo "Found local archive: $local_archive"
    cp "$local_archive" "$tmpdir/fonts.tar.xz"
  else
    if ! command -v gh &>/dev/null; then
      echo "Error: gh (GitHub CLI) not found and no local archive at $local_archive" >&2
      return 1
    fi
    echo "Downloading curated fonts (release: $FONT_RELEASE_TAG)..."
    if ! gh release download "$FONT_RELEASE_TAG" \
      --repo "$FONT_RELEASE_REPO" \
      --pattern "fonts.tar.xz" \
      --dir "$tmpdir" 2>/dev/null; then
      echo "Error: Failed to download fonts from release $FONT_RELEASE_TAG" >&2
      return 1
    fi
  fi

  echo "Installing to $font_dir..."
  mkdir -p "$font_dir"

  # Extract directly to font directory
  tar xf "$tmpdir/fonts.tar.xz" -C "$font_dir"

  local count
  count=$(tar tf "$tmpdir/fonts.tar.xz" | wc -l | xargs)
  echo "Extracted $count font files."

  local platform
  platform=$(detect_platform)

  # On WSL, register each font in Windows registry
  if [[ "$platform" == "wsl" ]]; then
    echo "Registering fonts in Windows..."
    for font_file in "$font_dir"/*.ttf "$font_dir"/*.otf; do
      [[ -f "$font_file" ]] || continue
      _register_windows_font "$font_file" "$(basename "$font_file")"
    done
  fi

  # Refresh font cache (Linux/WSL only, macOS does it automatically)
  if [[ "$platform" != "macos" ]]; then
    echo "Refreshing font cache..."
    fc-cache -f 2>/dev/null
  fi

  echo ""
  echo "✓ Curated fonts installed!"
  echo "  Run 'font install --check' to verify."
}

#==============================================================================
# MAIN COMMAND DISPATCHER
# ==============================================================================

main() {
  # Prints inline to stderr before the command runs, which is the call site the
  # library documents. Deferring it to an EXIT trap would land it after the
  # command's output, but install_fonts already sets its own EXIT trap for a
  # tmpdir, and bash traps are global — composing the two couples the notice to
  # a cleanup path that will drop it the next time either changes.
  #
  # Never fails and never prints an error; `font update` is where update
  # failures surface. The commands skipped here are the ones a check would be
  # pointless or harmful in — version is what a script parses.
  if declare -F bashselfupdate_notify &>/dev/null; then
    case "${1:-}" in
      update | upgrade | --version | -v) ;;
      *) bashselfupdate_notify font "$FONT_APP_DIR" ;;
    esac
  fi

  case "${1:-}" in
    --version | -v)
      echo "font $(get_version)"
      exit 0
      ;;
    list)
      list_fonts
      ;;
    current)
      show_current_font
      ;;
    info)
      show_font_info
      ;;
    change)
      change_font
      ;;
    apply)
      if [[ -z "${2:-}" ]]; then
        echo "Error: Font name required"
        usage
        exit 1
      fi
      # Validate font name against installed fonts
      local available_fonts
      available_fonts=$(list_fonts)
      if ! echo "$available_fonts" | grep -Fxq "$2"; then
        echo "Error: Font '$2' not found"
        echo ""
        local suggestions
        suggestions=$(echo "$available_fonts" | grep -i "${2//[-_ ]/.*}" | head -5)
        if [[ -n "$suggestions" ]]; then
          echo "Did you mean:"
          echo "  ${suggestions//$'\n'/$'\n'  }"
        fi
        echo ""
        echo "Run 'font list' to see all available fonts."
        exit 1
      fi
      apply_font_cmd "$2"
      ;;
    size-up)
      cmd_size_up
      ;;
    size-down)
      cmd_size_down
      ;;
    like)
      mark_liked "${@:2}"
      ;;
    dislike)
      mark_disliked "${@:2}"
      ;;
    note)
      add_note "${@:2}"
      ;;
    random)
      random_font
      ;;
    last)
      cmd_font_last
      ;;
    rank)
      show_rankings
      ;;
    stats)
      show_stats
      ;;
    log)
      show_log
      ;;
    reject)
      mark_rejected "${@:2}"
      ;;
    rejected)
      show_rejected
      ;;
    unreject)
      unreject_font_interactive
      ;;
    sync)
      case "${2:-}" in
        init)
          sync_init
          ;;
        status)
          sync_status
          ;;
        push)
          echo "Pushing to gist..."
          if sync_push; then
            echo "✓ Pushed successfully"
          else
            echo "✗ Push failed" >&2
            exit 1
          fi
          ;;
        pull)
          echo "Pulling from gist..."
          if sync_pull; then
            echo "✓ Pulled successfully"
          else
            echo "✗ Pull failed" >&2
            exit 1
          fi
          ;;
        off)
          sync_off
          ;;
        on)
          sync_on
          ;;
        *)
          echo "Usage: font sync <init|status|push|pull|on|off>"
          exit 1
          ;;
      esac
      ;;
    install)
      install_fonts "${2:-}"
      ;;
    upgrade | update)
      if ! declare -F bashselfupdate_update &>/dev/null; then
        echo "✗ font upgrade failed: bashselfupdate is not installed" >&2
        echo "  Re-run the installer: bash $FONT_APP_DIR/install.sh" >&2
        exit 1
      fi

      # Checked before attempting the update so the far more common cause gets
      # its own message. bashselfupdate_update returns the same non-zero for a
      # development checkout, an unreachable remote and a repository with no
      # releases, and "could not reach the remote" is actively misleading to
      # someone running font from a clone.
      if ! bashselfupdate_current_version "$FONT_APP_DIR" >/dev/null 2>&1; then
        echo "✗ font upgrade failed: $FONT_APP_DIR is not on a release tag ($(bashselfupdate_describe "$FONT_APP_DIR"))" >&2
        echo "  This is a development checkout. Use git to move it." >&2
        exit 1
      fi

      local moved
      if ! moved=$(bashselfupdate_update "$FONT_APP_DIR"); then
        echo "✗ font upgrade failed: could not reach the remote or find a release" >&2
        exit 1
      fi

      if [[ -z "$moved" ]]; then
        echo "✓ font already at latest: $(bashselfupdate_describe "$FONT_APP_DIR")"
        exit 0
      fi

      local from to
      read -r from to <<<"$moved"
      echo "✓ font upgraded: $from → $to"

      local changes
      changes=$(bashselfupdate_changelog "$FONT_APP_DIR" "$from" "$to")
      if [[ -n "$changes" ]]; then
        echo ""
        echo "Changes:"
        while IFS= read -r subject; do
          echo "  • $subject"
        done <<<"$changes"
      fi
      ;;
    *)
      usage
      exit 1
      ;;
  esac
}

main "$@"
